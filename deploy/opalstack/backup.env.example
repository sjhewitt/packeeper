# Settings for the nightly backup (~/bin/pac-keeper-backup). Copy this file
# to ~/pac-keeper-backup.env, fill it in, and run `chmod 600` on it.
# See "Backups to S3" in the README.

# The restic repository: an S3 bucket and a folder in it.
RESTIC_REPOSITORY="s3:s3.ca-central-1.amazonaws.com/BUCKET/pac-keeper"
# The password that encrypts the backups. Keep a copy in your password
# manager: without it, nobody can read the backups, you included.
RESTIC_PASSWORD="..."

# The access key of the IAM user that can write to the bucket only.
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_DEFAULT_REGION="ca-central-1"

# A Healthchecks.io ping URL. You get an email when a backup fails or does not run.
#PAC_BACKUP_PING_URL="https://hc-ping.com/..."

# The number of dated copies to keep on the server, for each app (default 7).
#PAC_BACKUP_KEEP_LOCAL=7
