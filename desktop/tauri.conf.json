{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PAC Keeper",
  "identifier": "ca.packeeper.desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Finance",
    "shortDescription": "Bookkeeping and reports for a BC school PAC",
    "longDescription": "PAC Keeper keeps the books of a BC school Parent Advisory Committee: bank imports, receipts, budgets, the gaming grant, and the monthly, AGM, and gaming reports.",
    "copyright": "PAC Keeper",
    "homepage": "https://packeeper.ca",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2MERDRTEyNDZBNTk1RDIKUldUU2xhVkdFczROeGdtUW5LT0h0SFB4OHdrZ1RQY0xtL1BackhNK21BTHZUVDJVb09FYjhGQlkK",
      "endpoints": [
        "https://github.com/sjhewitt/packeeper/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
